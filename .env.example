# ==========================================
# Delta Exchange Algo Trader Configuration
# ==========================================
# CAUTION: Testnet only! Real API keys should never be committed to git.

# Base URL & WebSocket (Delta Testnet)
# Global Testnet:
# DELTA_BASE_URL=https://cdn.testnet.deltaex.org
# DELTA_WS_URL=wss://socket.testnet.deltaex.org

# India Testnet (Default):
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_URL=wss://socket-ind.testnet.deltaex.org

# Authentication (Delta Testnet API keys with read + trade permissions)
DELTA_API_KEY=your_testnet_api_key_here
DELTA_API_SECRET=your_testnet_api_secret_here

# Trading Parameters
SYMBOL=BTCUSD
TIMEFRAME=15m
HTF_TIMEFRAME=1h

# Risk Management Controls
RISK_PER_TRADE_PCT=1.0
MAX_LEVERAGE=5
MAX_OPEN_POSITIONS=1
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_NOTIONAL_USD=50000.0
STALE_DATA_SECONDS=120

# System Settings
DEMO_MODE=False
DB_PATH=trader.db

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algo_bot
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
